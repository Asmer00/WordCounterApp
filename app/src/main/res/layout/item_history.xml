<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_metric_badge"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Original Text Preview -->
    <TextView
        android:id="@+id/tvHistoryOriginalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Good morning" />

    <!-- Compact Summary Line (e.g. Good morning -> 1, 2, 0, 0) -->
    <TextView
        android:id="@+id/tvHistoryCompactSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/primary_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Good morning -> 1, 2, 0, 0" />

    <!-- Detailed Metrics Breakdown -->
    <TextView
        android:id="@+id/tvHistoryMetricsBreakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="Sentences: 1 | Words: 2 | Punctuation: 0 | Numbers: 0" />

</LinearLayout>
